{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "exports",
    "src/components/**/*-framer-website-optimized",
    "src/components/**/*-framer-app-optimized",
    "src/components/www-xhulia-com-optimized",
    "src/components/my-framer-site 3",
    "src/components/newlamp",
    "src/components/altlamp",
    "src/newlamp",
    "src/components/liquid-metal-button/src/app",
    "src/components/liquid-metal-button/src/components/FramerRuntimeIsland.tsx",
    "src/components/liquid-metal-button/src/lib",
    "src/components/liquid-metal-button/next.config.ts"
  ]
}
